# Local development template. Copy this file to .env; never commit .env.
APP_ENV=development
APP_DEBUG=true
# Admin portal modes:
# disabled    - /admin returns a generic 404 (safe default)
# readonly    - read-only diagnostics for SUPERADMIN accounts
# development - local publisher and publish tool
ADMIN_PORTAL_MODE=development
APP_URL=http://localhost/mobileai-api
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobileai
DB_USERNAME=root
DB_PASSWORD=
# Server-to-server credentials shared only with the WordPress backend.
WORDPRESS_CLIENT_ID=wordpress-primary
WORDPRESS_CLIENT_SECRET=replace-with-at-least-32-random-bytes
WORDPRESS_SITE_ID=example.com
