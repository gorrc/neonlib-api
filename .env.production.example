APP_ENV=production
APP_DEBUG=false

# Keep the administration UI unavailable unless read-only diagnostics are needed.
ADMIN_PORTAL_MODE=disabled

APP_URL=https://neonlib-api.neonbreak.com

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_production_user
DB_PASSWORD=replace_with_strong_production_password

# Server-to-server credentials shared only with the WordPress backend.
WORDPRESS_CLIENT_ID=wordpress-primary
WORDPRESS_CLIENT_SECRET=replace_with_at_least_32_random_bytes
WORDPRESS_SITE_ID=neonbreak.com

